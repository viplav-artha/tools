# Copy this file to .env and fill in real values. Never commit .env itself.

# Bedrock model to call (Converse API model ID)
BEDROCK_CHAT_MODEL_ID=us.amazon.nova-pro-v1:0

# AWS region the model is available in
BEDROCK_REGION=us-east-1

# Named AWS SSO profile to use for credentials
AWS_PROFILE=your-aws-profile

# Sampling temperature (0 = deterministic)
LLM_TEMPERATURE=0

# Tavily API key (get one at https://tavily.com) — used by tools/search_tool.py
TAVILY_API_KEY=your-tavily-api-key
